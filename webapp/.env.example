# Environment Configuration for LLM Inference UI

# Server Configuration
PORT=3000

# Python Path (adjust if using virtual environment)
# Windows example: PYTHON_PATH=C:\Python311\python.exe
# Linux example: PYTHON_PATH=/usr/bin/python3
# Virtual env: PYTHON_PATH=./venv/bin/python
PYTHON_PATH=python

# HuggingFace Token (required for model access)
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Logging Configuration
# Options: DEBUG, INFO, WARN, ERROR
# DEBUG - Verbose logging with all details (use for development/debugging)
# INFO - Normal operation logging (recommended for production)
# WARN - Only warnings and errors
# ERROR - Only errors
LOG_LEVEL=INFO
